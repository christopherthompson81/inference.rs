<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:InferenceRs.AvaloniaDemo.ViewModels"
        x:Class="InferenceRs.AvaloniaDemo.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Settings"
        Icon="/Assets/icon.png"
        Width="640" Height="760" MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="12">
    <SelectableTextBlock DockPanel.Dock="Bottom" Classes="error" Text="{Binding Error}" IsVisible="{Binding HasError}"
                         Margin="0,8,0,0" />
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,10,0,0">
      <TextBlock Classes="muted" VerticalAlignment="Center" Text="{Binding SettingsFile}" TextTrimming="CharacterEllipsis" />
      <Button Grid.Column="1" Content="Cancel" Click="OnCancel" />
      <Button Grid.Column="2" Classes="accent" Content="Save" Click="OnSave" />
    </Grid>
    <ScrollViewer>
      <StackPanel Spacing="10">
        <Border Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Classes="heading" Text="Loading" />
            <TextBlock Classes="muted" Text="The device and context length new model slots start with." />
            <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6">
              <TextBlock VerticalAlignment="Center" Text="Device" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding Devices}" SelectedItem="{Binding Settings.Device}" MinWidth="140" />
              <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Context length (tokens)" />
              <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding Settings.ContextLength}" Minimum="512" Maximum="1048576"
                             Increment="1024" FormatString="0" HorizontalAlignment="Left" />
              <CheckBox Grid.Row="2" Grid.ColumnSpan="2" IsChecked="{Binding Settings.Mtp}"
                        Content="Speculative decoding (MTP) for chat models with a built-in draft head" />
              <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="Draft tokens (0: default)" />
              <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding Settings.MtpDrafts}" Minimum="0" Maximum="8"
                             Increment="1" FormatString="0" HorizontalAlignment="Left" />
            </Grid>
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Classes="heading" Text="Sampling" />
            <TextBlock Classes="muted" Text="What the chat panel starts with; applied to it on save." />
            <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
              <TextBlock VerticalAlignment="Center" Text="Temperature" />
              <NumericUpDown Grid.Column="1" Value="{Binding Settings.Temperature}" Minimum="0" Maximum="2" Increment="0.05"
                             FormatString="0.00" HorizontalAlignment="Left" />
              <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Top p" />
              <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding Settings.TopP}" Minimum="0" Maximum="1" Increment="0.05"
                             FormatString="0.00" HorizontalAlignment="Left" />
              <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Top k (0: off)" />
              <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding Settings.TopK}" Minimum="0" Maximum="1000" Increment="1"
                             FormatString="0" HorizontalAlignment="Left" />
              <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="Min p (0: off)" />
              <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding Settings.MinP}" Minimum="0" Maximum="1" Increment="0.01"
                             FormatString="0.00" HorizontalAlignment="Left" />
              <TextBlock Grid.Row="4" VerticalAlignment="Center" Text="Max tokens" />
              <NumericUpDown Grid.Row="4" Grid.Column="1" Value="{Binding Settings.MaxTokens}" Minimum="1" Maximum="32768"
                             Increment="64" FormatString="0" HorizontalAlignment="Left" />
              <CheckBox Grid.Row="5" Grid.ColumnSpan="2" IsChecked="{Binding Settings.EnableThinking}"
                        Content="Let the model reason first" />
            </Grid>
            <TextBlock Text="System prompt" />
            <TextBox Text="{Binding Settings.SystemPrompt}" AcceptsReturn="True" TextWrapping="Wrap" Height="80" />
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Classes="heading" Text="Model folders" />
            <TextBlock Classes="muted" Text="Where the model manager looks for models, a few levels deep." />
            <ItemsControl ItemsSource="{Binding Folders}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                    <TextBlock VerticalAlignment="Center" Text="{Binding}" TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="1" Content="Remove"
                            Command="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).RemoveFolderCommand}"
                            CommandParameter="{Binding}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="Add folder..." Command="{Binding AddFolderCommand}" />
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Classes="heading" Text="Hugging Face" />
            <TextBlock Text="Cache directory" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
              <TextBox Text="{Binding HfCachePath}" PlaceholderText="Empty: HF_HUB_CACHE, else ~/.cache/huggingface/hub" />
              <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseHfCacheCommand}" />
            </Grid>
            <TextBlock Text="Access token (for gated repositories)" />
            <TextBox Text="{Binding Settings.HfToken}" PasswordChar="*"
                     PlaceholderText="Empty: the token hf auth login saved" />
            <TextBlock Classes="muted" Text="Stored in the settings file, readable only by you." />
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Classes="heading" Text="Session" />
            <CheckBox IsChecked="{Binding Settings.RestoreSession}" Content="Remember each tab's model and restore it at startup" />
            <CheckBox IsChecked="{Binding Settings.LoadOnStartup}" Content="Load the restored models at startup" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
