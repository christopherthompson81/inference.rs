<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:InferenceRs.AvaloniaDemo.ViewModels"
             x:Class="InferenceRs.AvaloniaDemo.Views.EngineView"
             x:DataType="vm:EngineViewModel">
  <Grid Margin="12" ColumnDefinitions="*,*" RowDefinitions="Auto,*" ColumnSpacing="10" RowSpacing="10">
    <Border Grid.ColumnSpan="2" Classes="card">
      <StackPanel Spacing="8">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Classes="heading" VerticalAlignment="Center" Text="Chat engine models" />
          <Button Content="Refresh" Command="{Binding RefreshCommand}" />
          <TextBlock Classes="muted" VerticalAlignment="Center" Text="{Binding Status}" />
        </StackPanel>
        <!-- rows share their column widths, so an alias row with no buttons lines up with the rest -->
        <ItemsControl ItemsSource="{Binding Models}" Grid.IsSharedSizeScope="True">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ServedModelViewModel">
              <Grid ColumnSpacing="8" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="120" />
                  <ColumnDefinition Width="Auto" SharedSizeGroup="Unload" />
                  <ColumnDefinition Width="Auto" SharedSizeGroup="Reload" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="{Binding Id}" />
                <TextBlock Grid.Column="1" Classes="muted" VerticalAlignment="Center" Text="{Binding Status}" />
                <Button Grid.Column="2" Content="Unload" IsVisible="{Binding CanOperate}"
                        Command="{Binding $parent[UserControl].((vm:EngineViewModel)DataContext).UnloadCommand}"
                        CommandParameter="{Binding}" />
                <Button Grid.Column="3" Content="Reload" IsVisible="{Binding CanOperate}"
                        Command="{Binding $parent[UserControl].((vm:EngineViewModel)DataContext).ReloadCommand}"
                        CommandParameter="{Binding}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
    <Border Grid.Row="1" Classes="card">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Classes="heading" Text="Metrics" Margin="0,0,0,6" />
        <ScrollViewer>
          <StackPanel Spacing="8">
            <TextBlock Text="Prefix cache" FontWeight="SemiBold" />
            <SelectableTextBlock Classes="mono" Text="{Binding CacheStats}" />
            <TextBlock Text="Speculative decoding" FontWeight="SemiBold" />
            <SelectableTextBlock Classes="mono" Text="{Binding SpeculativeStats}" />
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>
    <Border Grid.Row="1" Grid.Column="1" Classes="card">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Classes="heading" Text="System" Margin="0,0,0,6" />
        <ScrollViewer>
          <SelectableTextBlock Classes="mono" Text="{Binding SystemReport}" />
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
