    "min_positive_scores_rate": 0.5,
    "strong_boost_rate": 0.75,
    "weak_boost_rate": 1.5,
    "fifo_length": 16,
    "speaker_cache_update_period": 12,
    "num_speakers": 4,
    "subsampling_factor": 8
  },
  "chunk_length": 10,
  "chunk_right_context": 2,
  "fifo_length": 4,
  "speaker_cache_update_period": 6
