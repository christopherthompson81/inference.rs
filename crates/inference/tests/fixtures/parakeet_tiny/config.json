{
  "architectures": ["ParakeetForTDT"],
  "model_type": "parakeet_tdt",
  "blank_token_id": 32,
  "pad_token_id": 1,
  "vocab_size": 33,
  "decoder_hidden_size": 16,
  "num_decoder_layers": 2,
  "durations": [0, 1, 2, 3, 4],
  "hidden_act": "relu",
  "max_symbols_per_step": 10,
  "encoder_config": {
    "model_type": "parakeet_encoder",
