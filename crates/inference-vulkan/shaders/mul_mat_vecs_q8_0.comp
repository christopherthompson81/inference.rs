#version 450
// A Q8_0 W: rows of 34-byte blocks, an f16 scale and 32 int8 values.
#extension GL_GOOGLE_include_directive : require
#include "mat_vec_head.glsl"

const uint BLOCK_U16 = 17;

void decode(uint base, out float v[QK]) {
    float d = unpackHalf2x16(uint(w[base])).x;
    [[unroll]] for (uint j = 0; j < QK / 2; j++) {
        uint q = uint(w[base + 1 + j]);
        // the two int8 values a u16 holds, sign-extended
        v[2 * j] = d * float(int(q << 24) >> 24);
        v[2 * j + 1] = d * float(int(q << 16) >> 24);
    }
}

#include "mat_vec_main.glsl"
