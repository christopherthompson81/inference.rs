#version 450
// Groups a step's routes by expert, for moe_mm, into one u32 buffer: `order` (the slots expert by expert) at 0,
// then at tiles_off the tile count and the tiles, (expert, first place in `order`, routes) each, an expert's routes
// cut into tiles of TILE. One workgroup.

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer Ids { uint ids[]; };
layout(std430, binding = 1) writeonly buffer Routing { uint routing[]; };

layout(push_constant) uniform PushConstants {
    uint slots;
    uint experts;
    uint ids_off;
    uint tiles_off;
} pc;

const uint THREADS = 256;
const uint MAX_EXPERTS = 1024;
// moe_mm's tokens a tile
const uint TILE = 64;

shared uint counts[MAX_EXPERTS];
shared uint starts[MAX_EXPERTS];

void main() {
    uint t = gl_LocalInvocationID.x;
    for (uint e = t; e < pc.experts; e += THREADS) {
        counts[e] = 0;
    }
    barrier();
    for (uint s = t; s < pc.slots; s += THREADS) {
        atomicAdd(counts[ids[pc.ids_off + s]], 1u);
    }
    barrier();
    if (t == 0) {
        uint sum = 0;
        uint tiles = 0;
        for (uint e = 0; e < pc.experts; e++) {
            starts[e] = sum;
            for (uint c = 0; c < counts[e]; c += TILE) {
                uint at = pc.tiles_off + 1 + 3 * tiles;
                routing[at] = e;
                routing[at + 1] = sum + c;
                routing[at + 2] = min(TILE, counts[e] - c);
                tiles++;
            }
            sum += counts[e];
            // from here the expert's cursor
            counts[e] = 0;
        }
        routing[pc.tiles_off] = tiles;
    }
    barrier();
    // each slot to its expert's next place: an expert's routes in no set order, as each route's output is its own and
    // only which tile computes it changes (a thread an expert scanning every slot was most of a prompt step's sort)
    for (uint s = t; s < pc.slots; s += THREADS) {
        uint e = ids[pc.ids_off + s];
        routing[starts[e] + atomicAdd(counts[e], 1u)] = s;
    }
}
