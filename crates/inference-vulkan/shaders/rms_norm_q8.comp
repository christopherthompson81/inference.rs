#version 450
// rows_f32's RMS norm (times `alpha`, a workgroup a row) that also writes its output as quantize_q8_1's int8 blocks
// (row-major over the rows' blocks), so the matvecs that read it run no quantize. A thread holds 4 adjacent values of
// each 4096 the row has (at most MAX_PASSES), so the row is read once; 8 lanes are a block, its max and sum clustered
// over them. A value is the expression the output's is written with, so the blocks match quantizing the written row.
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_clustered : require
#extension GL_EXT_control_flow_attributes : require

layout(local_size_x = 1024) in;

layout(std430, binding = 0) readonly buffer X { float x[]; };
layout(std430, binding = 1) readonly buffer Alpha { float alpha[]; };
layout(std430, binding = 2) writeonly buffer O { float o[]; };
layout(std430, binding = 3) writeonly buffer Q { uint q[]; };
layout(std430, binding = 4) writeonly buffer S { vec2 s[]; };

layout(push_constant) uniform PushConstants {
    uint rows;
    uint cols;
    float eps;
    uint x_off;
    uint alpha_off;
    uint o_off;
    // where (d, d * sum q) start in their buffer, in vec2s
    uint s_off;
} pc;

const uint THREADS = 1024;
const uint LANE_VALUES = 4;
const uint BLOCK_LANES = 8;
// the row's passes of THREADS * LANE_VALUES values (ops.rs's RMS_Q8_MAX_COLS), and subgroups as narrow as 8 lanes
const uint MAX_PASSES = 4;
const uint MAX_SUBGROUPS = THREADS / 8;

shared float red[MAX_SUBGROUPS];

void main() {
    uint row = gl_WorkGroupID.x;
    if (row >= pc.rows) {
        return;
    }
    uint t = gl_LocalInvocationID.x;
    uint base = pc.x_off + row * pc.cols;
    vec4 v[MAX_PASSES];
    float ss = 0.0;
    [[unroll]] for (uint p = 0; p < MAX_PASSES; p++) {
        uint at = (p * THREADS + t) * LANE_VALUES;
        v[p] = vec4(0.0);
        if (at < pc.cols) {
            v[p] = vec4(x[base + at], x[base + at + 1], x[base + at + 2], x[base + at + 3]);
            ss += dot(v[p], v[p]);
        }
    }
    ss = subgroupAdd(ss);
    if (subgroupElect()) {
        red[gl_SubgroupID] = ss;
    }
    barrier();
    float total = 0.0;
    for (uint g = 0; g < gl_NumSubgroups; g++) {
        total += red[g];
    }
    float scale = 1.0 / sqrt(total / float(pc.cols) + pc.eps);
    uint lane = t % BLOCK_LANES;
    [[unroll]] for (uint p = 0; p < MAX_PASSES; p++) {
        uint at = (p * THREADS + t) * LANE_VALUES;
        // whole blocks of whole clusters (cols a multiple of 32), so a cluster is live or not as one
        bool live = at < pc.cols;
        vec4 w = vec4(0.0);
        if (live) {
            uint a = pc.alpha_off + at;
            w = v[p] * scale * vec4(alpha[a], alpha[a + 1], alpha[a + 2], alpha[a + 3]);
            uint out_at = pc.o_off + row * pc.cols + at;
            o[out_at] = w.x;
            o[out_at + 1] = w.y;
            o[out_at + 2] = w.z;
            o[out_at + 3] = w.w;
        }
        vec4 aw = abs(w);
        float amax = subgroupClusteredMax(max(max(aw.x, aw.y), max(aw.z, aw.w)), BLOCK_LANES);
        float d = amax / 127.0;
        float rcp = d > 0.0 ? 1.0 / d : 0.0;
        ivec4 qv = ivec4(round(w * rcp));
        int sum = subgroupClusteredAdd(qv.x + qv.y + qv.z + qv.w, BLOCK_LANES);
        if (live) {
            uint block = row * (pc.cols / 32) + at / 32;
            q[block * BLOCK_LANES + lane] = (uint(qv.x) & 0xffu) | ((uint(qv.y) & 0xffu) << 8)
                | ((uint(qv.z) & 0xffu) << 16) | ((uint(qv.w) & 0xffu) << 24);
            if (lane == 0) {
                s[pc.s_off + block] = vec2(d, d * float(sum));
            }
        }
    }
}
