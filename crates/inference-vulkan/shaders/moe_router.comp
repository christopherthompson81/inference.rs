#version 450
// Top-k MoE routing a token a workgroup, as inference_nn's CPU router: scores (raw, softmax or sigmoid of the clipped
// logits), the selection bias added for choosing only, the top k by a stable descending order (ties to the lower
// expert), their weights (the scores, or a softmax or sigmoid of their logits), renormalized and scaled. The scores
// and each pick's argmax run over the workgroup.
#extension GL_KHR_shader_subgroup_arithmetic : require

layout(local_size_x = 128) in;

layout(std430, binding = 0) readonly buffer L { float logits[]; };
layout(std430, binding = 1) readonly buffer Bias { float bias[]; };
layout(std430, binding = 2) writeonly buffer V { float values[]; };
layout(std430, binding = 3) writeonly buffer I { uint indices[]; };

layout(push_constant) uniform PushConstants {
    uint tokens;
    uint experts;
    uint top_k;
    uint score_fn;
    uint weight_fn;
    uint renormalize;
    uint has_bias;
    uint has_clip;
    float clip_min;
    float clip_max;
    float norm_min;
    float output_scale;
    uint logits_off;
} pc;

const uint THREADS = 128;
const uint MAX_EXPERTS = 1024;
const uint MAX_TOP_K = 32;
const uint NONE = 0xffffffffu;
// score and weight functions, as `RouterFn` numbers them
const uint SOFTMAX = 1;
const uint SIGMOID = 2;

shared float logit[MAX_EXPERTS];
shared float score[MAX_EXPERTS];
shared bool taken[MAX_EXPERTS];
shared float red_v[THREADS];
shared uint red_i[THREADS];
// a subgroup's best, at most THREADS subgroups (one-lane subgroups)
shared float sg_v[THREADS];
shared uint sg_i[THREADS];
shared uint chosen[MAX_TOP_K];

// the workgroup's largest `v` and its index, the lower index among equals; NONE indices lose: a subgroup's max and its
// lowest index at that max, then the subgroups' in shared memory
void best(float v, uint i, out float bv, out uint bi) {
    bool valid = i != NONE;
    float top = subgroupMax(valid ? v : -1.0 / 0.0);
    uint top_i = subgroupMin(valid && v == top ? i : NONE);
    if (subgroupElect()) {
        sg_v[gl_SubgroupID] = top;
        sg_i[gl_SubgroupID] = top_i;
    }
    barrier();
    bv = 0.0;
    bi = NONE;
    for (uint g = 0; g < gl_NumSubgroups; g++) {
        uint oi = sg_i[g];
        if (oi != NONE && (bi == NONE || sg_v[g] > bv || (sg_v[g] == bv && oi < bi))) {
            bv = sg_v[g];
            bi = oi;
        }
    }
    barrier();
}

void main() {
    uint tok = gl_WorkGroupID.x;
    uint t = gl_LocalInvocationID.x;
    uint base = pc.logits_off + tok * pc.experts;
    float m = -1.0 / 0.0;
    for (uint e = t; e < pc.experts; e += THREADS) {
        float l = logits[base + e];
        l = pc.has_clip != 0 ? clamp(l, pc.clip_min, pc.clip_max) : l;
        logit[e] = l;
        taken[e] = false;
        m = max(m, l);
    }
    float bv;
    uint bi;
    best(m, t < pc.experts ? t : NONE, bv, bi);
    m = bv;
    float total = 0.0;
    for (uint e = t; e < pc.experts; e += THREADS) {
        float s = logit[e];
        if (pc.score_fn == SOFTMAX) {
            s = exp(s - m);
            total += s;
        } else if (pc.score_fn == SIGMOID) {
            s = 1.0 / (1.0 + exp(-s));
        }
        score[e] = s;
    }
    if (pc.score_fn == SOFTMAX) {
        red_v[t] = total;
        barrier();
        for (uint s = THREADS / 2; s > 0; s >>= 1) {
            if (t < s) {
                red_v[t] += red_v[t + s];
            }
            barrier();
        }
        total = red_v[0];
        barrier();
        for (uint e = t; e < pc.experts; e += THREADS) {
            score[e] /= total;
        }
    }
    barrier();
    for (uint j = 0; j < pc.top_k; j++) {
        float v = 0.0;
        uint idx = NONE;
        for (uint e = t; e < pc.experts; e += THREADS) {
            float c = score[e] + (pc.has_bias != 0 ? bias[e] : 0.0);
            if (!taken[e] && (idx == NONE || c > v)) {
                v = c;
                idx = e;
            }
        }
        best(v, idx, bv, bi);
        if (t == 0) {
            chosen[j] = bi;
            taken[bi] = true;
        }
        barrier();
    }
    if (t != 0) {
        return;
    }
    float picked[MAX_TOP_K];
    float wm = -1.0 / 0.0;
    for (uint j = 0; j < pc.top_k; j++) {
        wm = max(wm, logit[chosen[j]]);
    }
    float wsum = 0.0;
    for (uint j = 0; j < pc.top_k; j++) {
        float w = score[chosen[j]];
        if (pc.weight_fn == SOFTMAX) {
            w = exp(logit[chosen[j]] - wm);
            wsum += w;
        } else if (pc.weight_fn == SIGMOID) {
            w = 1.0 / (1.0 + exp(-logit[chosen[j]]));
        }
        picked[j] = w;
    }
    float denominator = 0.0;
    for (uint j = 0; j < pc.top_k; j++) {
        if (pc.weight_fn == SOFTMAX) {
            picked[j] /= wsum;
        }
        denominator += picked[j];
    }
    if (pc.norm_min > 0.0) {
        denominator = max(denominator, pc.norm_min);
    }
    for (uint j = 0; j < pc.top_k; j++) {
        float w = pc.renormalize != 0 ? picked[j] / denominator : picked[j];
        values[tok * pc.top_k + j] = w * pc.output_scale;
        indices[tok * pc.top_k + j] = chosen[j];
    }
}
