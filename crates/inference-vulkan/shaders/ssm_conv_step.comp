#version 450
// One decode step of Mamba's causal conv on a conv-state pool, in place: batch row b shifts x[b] into the pool's row
// slots[b] (pool f32 (rows, channels, kernel)) and writes silu(window . weight + bias); a slot past i32::MAX marks a
// padding row, which writes 0 and leaves the pool.

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer X { float x[]; };
layout(std430, binding = 1) readonly buffer W { float weight[]; };
layout(std430, binding = 2) readonly buffer Bias { float bias[]; };
layout(std430, binding = 3) buffer Pool { float pool[]; };
layout(std430, binding = 4) readonly buffer Slots { uint slots[]; };
layout(std430, binding = 5) writeonly buffer O { float o[]; };

layout(push_constant) uniform PushConstants {
    uint batch;
    uint channels;
    uint kernel;
    uint has_bias;
    uint x_off;
    uint weight_off;
    uint bias_off;
    uint pool_off;
    uint slots_off;
} pc;

const uint PAD_SLOT = 0x7fffffffu;

void main() {
    uint total = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
    for (uint e = gl_GlobalInvocationID.x; e < pc.batch * pc.channels; e += total) {
        uint b = e / pc.channels;
        uint ch = e % pc.channels;
        uint slot = slots[pc.slots_off + b];
        if (slot > PAD_SLOT) {
            o[e] = 0.0;
            continue;
        }
        uint w0 = pc.pool_off + (slot * pc.channels + ch) * pc.kernel;
        float sum = 0.0;
        for (uint j = 0; j + 1 < pc.kernel; j++) {
            float v = pool[w0 + j + 1];
            pool[w0 + j] = v;
            sum += v * weight[pc.weight_off + ch * pc.kernel + j];
        }
        float xv = x[pc.x_off + e];
        pool[w0 + pc.kernel - 1] = xv;
        sum += xv * weight[pc.weight_off + ch * pc.kernel + pc.kernel - 1];
        if (pc.has_bias != 0) {
            sum += bias[pc.bias_off + ch];
        }
        o[e] = sum / (1.0 + exp(-sum));
    }
}
