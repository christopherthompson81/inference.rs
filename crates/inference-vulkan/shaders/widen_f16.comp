#version 450
// `count` f16s from h_base as f32s into x from x_base, one a thread.
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer H { float16_t h[]; };
layout(std430, binding = 1) writeonly buffer X { float x[]; };

layout(push_constant) uniform PushConstants {
    uint count;
    uint h_base;
    uint x_base;
} pc;

void main() {
    uint i = gl_GlobalInvocationID.y * (gl_NumWorkGroups.x * 256) + gl_GlobalInvocationID.x;
    if (i < pc.count) {
        x[pc.x_base + i] = float(h[pc.h_base + i]);
    }
}
