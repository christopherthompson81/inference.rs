#version 450
// The int8 matrix-core prompt matmul over a MXFP4 W: tile y over the tokens in order.
#extension GL_GOOGLE_include_directive : require
#include "mul_mmq_cm_head.glsl"

layout(push_constant) uniform PushConstants {
    uint rows;
    uint cols;
    // element offsets into the bound buffers: `w` in u16s, `y` in floats
    uint w_base;
    uint y_base;
    // activation rows; output row t is `rows` long
    uint m;
    // where the blocks' (d, d * sum q) start, in vec2s
    uint s_off;
} pc;

#include "mxfp4_int8.glsl"

const uint TILE_TOKENS = 128;

uint m0;

bool begin_tile(out uint tokens, out uint w_matrix) {
    m0 = gl_WorkGroupID.y * TILE_TOKENS;
    tokens = min(TILE_TOKENS, pc.m - m0);
    w_matrix = pc.w_base;
    return true;
}

uint x_row(uint j) {
    return m0 + j;
}

uint y_row(uint j) {
    return m0 + j;
}

#include "mul_mmq_cm_main.glsl"
