#version 450
// A row's K largest f32 logits, sorted descending (ties to the lower index), and its softmax normalizer at
// `inv_temperature`, from ranked_topk_part's chunks: their candidates, in chunk order, selected again, and their
// sums rescaled to the row's max. Writes `2K + 2` floats a row: the values, their indices (as floats),
// sum(exp(x * inv_temperature - max)) and max * inv_temperature (CUDA's packed top-k layout). Masked (-inf) and NaN
// entries count as the lowest key and never enter the sum.
#extension GL_GOOGLE_include_directive : require

layout(std430, binding = 0) readonly buffer P { float part[]; };
layout(std430, binding = 1) writeonly buffer O { float o[]; };

layout(push_constant) uniform PushConstants {
    uint chunks;
    float inv_temperature;
} pc;

uint pbase;
#define VALUE(i) part[pbase + ((i) / K) * (2 * K + 2) + (i) % K]
#define INDEX(i) floatBitsToUint(part[pbase + ((i) / K) * (2 * K + 2) + K + (i) % K])
#include "ranked_topk_main.glsl"

void main() {
    uint t = gl_LocalInvocationID.x;
    uint row = gl_WorkGroupID.x;
    pbase = row * pc.chunks * (2 * K + 2);

    float m = -1.0 / 0.0;
    for (uint c = t; c < pc.chunks; c += THREADS) {
        m = max(m, part[pbase + c * (2 * K + 2) + 2 * K]);
    }
    m = workgroup_max(m);
    float z = 0.0;
    for (uint c = t; c < pc.chunks; c += THREADS) {
        float cm = part[pbase + c * (2 * K + 2) + 2 * K];
        if (!isinf(cm)) {
            z += part[pbase + c * (2 * K + 2) + 2 * K + 1] * exp((cm - m) * pc.inv_temperature);
        }
    }
    z = workgroup_sum(z);
    select_top(pc.chunks * K);

    uint row_out = row * (2 * K + 2);
    if (t < K) {
        o[row_out + t] = cand_v[t];
        o[row_out + K + t] = float(cand_i[t]);
    }
    if (t == 0) {
        o[row_out + 2 * K] = z;
        o[row_out + 2 * K + 1] = m * pc.inv_temperature;
    }
}
