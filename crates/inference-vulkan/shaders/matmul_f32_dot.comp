#version 450
// c[b] = a[b] (m x k) times b[b] (k x n), every operand strided, c contiguous, as matmul_f32.comp: here a workgroup an
// output element, its threads striding over k and summing by subgroups, then the subgroups' sums, for a long k.
#extension GL_KHR_shader_subgroup_arithmetic : require

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer A { float a[]; };
layout(std430, binding = 1) readonly buffer B { float bm[]; };
layout(std430, binding = 2) buffer C { float c[]; };

layout(push_constant) uniform PushConstants {
    uint batch;
    uint m;
    uint n;
    uint k;
    uint a_off;
    uint a_bs;
    uint a_ms;
    uint a_ks;
    uint b_off;
    uint b_bs;
    uint b_ks;
    uint b_ns;
} pc;

const uint THREADS = 256;
// one sum a subgroup, for subgroups as narrow as 8
const uint MAX_SUBGROUPS = THREADS / 8;
shared float red[MAX_SUBGROUPS];

void main() {
    uint e = gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x;
    if (e >= pc.batch * pc.m * pc.n) {
        return;
    }
    uint t = gl_LocalInvocationID.x;
    uint col = e % pc.n;
    uint row = (e / pc.n) % pc.m;
    uint bat = e / (pc.n * pc.m);
    uint ia = pc.a_off + bat * pc.a_bs + row * pc.a_ms;
    uint ib = pc.b_off + bat * pc.b_bs + col * pc.b_ns;
    float s = 0.0;
    for (uint j = t; j < pc.k; j += THREADS) {
        s += a[ia + j * pc.a_ks] * bm[ib + j * pc.b_ks];
    }
    s = subgroupAdd(s);
    if (subgroupElect()) {
        red[gl_SubgroupID] = s;
    }
    barrier();
    if (t == 0) {
        float total = 0.0;
        for (uint g = 0; g < gl_NumSubgroups; g++) {
            total += red[g];
        }
        c[e] = total;
    }
}
