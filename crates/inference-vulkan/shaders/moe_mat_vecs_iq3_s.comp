#version 450
// y[slot] = W[ids[slot]] x[slot / x_div] for a stack of IQ3_S experts W (each `rows x cols`), the activation rows as
// quantize_q8_1's int8 blocks: grid z is a slot, and the slot leading a run of up to MAX_M of its expert's slots
// computes them all (each weight block packed to int8 once for every member) while the rest leave. A workgroup takes
// ROWS weight rows.
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_control_flow_attributes : require
#extension GL_EXT_integer_dot_product : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_basic : require

layout(local_size_x = 32) in;

layout(std430, binding = 0) readonly buffer W { uint16_t w[]; };
layout(std430, binding = 1) readonly buffer Q { uvec4 xq[]; };
layout(std430, binding = 2) writeonly buffer Y { float y[]; };
layout(std430, binding = 3) readonly buffer Ids { uint ids[]; };
layout(std430, binding = 4) readonly buffer S { vec2 xs[]; };

layout(push_constant) uniform PushConstants {
    uint rows;
    uint cols;
    // element offsets into the bound buffers: `w` in u16s, `y` in floats
    uint w_base;
    uint y_base;
    // workgroups per grid row, the grid's second dimension carrying what one dimension's limit cannot
    uint groups_x;
    // slots an activation row serves (a projection of the token's input: its routes), or 1 (of each route's own)
    uint x_div;
    uint ids_off;
    // u16s from one expert's matrix to the next
    uint expert_u16;
    uint slots;
    // where the blocks' (d, d * sum q) start, in vec2s
    uint s_off;
} pc;

const uint THREADS = 32;
const uint QK = 32;
const uint ROWS = 4;
const uint MAX_M = 8;
const uint MAX_SUBGROUPS = THREADS / 8;
shared float partial[ROWS * MAX_M][MAX_SUBGROUPS];

#include "int8_dot.glsl"
#include "iq3_s_int8.glsl"
#include "block_at.glsl"

void main() {
    uint slot = gl_WorkGroupID.z;
    uint expert = ids[pc.ids_off + slot];
    uint before = 0;
    for (uint s = 0; s < slot; s++) {
        before += uint(ids[pc.ids_off + s] == expert);
    }
    // the whole workgroup leaves together, before any barrier
    if (before % MAX_M != 0) {
        return;
    }
    uint members[MAX_M];
    uint m = 0;
    for (uint s = slot; s < pc.slots && m < MAX_M; s++) {
        if (ids[pc.ids_off + s] == expert) {
            members[m] = s;
            m++;
        }
    }
    uint row0 = (gl_WorkGroupID.y * pc.groups_x + gl_WorkGroupID.x) * ROWS;
    uint w_expert = pc.w_base + expert * pc.expert_u16;
    uint tid = gl_LocalInvocationID.x;
    uint blocks = pc.cols / QK;
    float acc[ROWS * MAX_M];
    [[unroll]] for (uint i = 0; i < ROWS * MAX_M; i++) {
        acc[i] = 0.0;
    }
    for (uint b = tid; b < blocks; b += THREADS) {
        COEF coef[ROWS];
        uvec4 lo[ROWS];
        uvec4 hi[ROWS];
        [[unroll]] for (uint r = 0; r < ROWS; r++) {
            // a row past the matrix decodes the last one, its sums never written
            coef[r] = pack_coef(unpack(w_expert, min(row0 + r, pc.rows - 1), b, blocks, lo[r], hi[r]));
        }
        [[unroll]] for (uint mi = 0; mi < MAX_M; mi++) {
            if (mi >= m) {
                break;
            }
            uint xb = (members[mi] / pc.x_div) * blocks + b;
            uvec4 x_lo = xq[2 * xb], x_hi = xq[2 * xb + 1];
            XSCALE sx = pack_xs(xs[pc.s_off + xb]);
            [[unroll]] for (uint r = 0; r < ROWS; r++) {
                acc[r * MAX_M + mi] += block_dot(lo[r], hi[r], coef[r], x_lo, x_hi, sx);
            }
        }
    }
    [[unroll]] for (uint mi = 0; mi < MAX_M; mi++) {
        if (mi >= m) {
            break;
        }
        [[unroll]] for (uint r = 0; r < ROWS; r++) {
            float sum = subgroupAdd(acc[r * MAX_M + mi]);
            if (subgroupElect()) {
                partial[r * MAX_M + mi][gl_SubgroupID] = sum;
            }
        }
    }
    barrier();
    if (tid == 0) {
        for (uint r = 0; r < ROWS; r++) {
            if (row0 + r >= pc.rows) {
                break;
            }
            for (uint mi = 0; mi < m; mi++) {
                float sum = 0.0;
                for (uint g = 0; g < gl_NumSubgroups; g++) {
                    sum += partial[r * MAX_M + mi][g];
                }
                y[pc.y_base + members[mi] * pc.rows + row0 + r] = sum;
            }
        }
    }
}
