#version 450
// x as f16 for the matrix-core prompt matmuls: `count` f32s from x_base, two a thread.
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer X { float x[]; };
layout(std430, binding = 1) writeonly buffer H { f16vec2 h[]; };

layout(push_constant) uniform PushConstants {
    uint count;
    uint x_base;
} pc;

void main() {
    uint i = gl_GlobalInvocationID.y * (gl_NumWorkGroups.x * 256) + gl_GlobalInvocationID.x;
    if (2 * i >= pc.count) {
        return;
    }
    float b = 2 * i + 1 < pc.count ? x[pc.x_base + 2 * i + 1] : 0.0;
    h[i] = f16vec2(float16_t(x[pc.x_base + 2 * i]), float16_t(b));
}
