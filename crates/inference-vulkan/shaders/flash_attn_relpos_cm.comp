#version 450
// flash_attn_cm.comp's attention with a relative-position term (Transformer-XL, as the FastConformer's), a query head
// a key head: score(i, j) = qc_i . k_j + qp_i . p[pos_base - i + j], both query sets scaled beforehand. A workgroup
// takes BR positions of a head; each of its 4 subgroups (of 32) runs its 16 rows over the keys BC at a time on its
// own, loading keys, values and positions as matrices straight from f16 tables: it scores its rows against the
// tile's keys, and multiplies its rows' position queries against the 16 + BC - 1 position rows the tile's (row, key)
// pairs read, a contiguous span; a pair's term is that product's entry (r, 15 - r + key), a diagonal. The tables are
// padded before their first head and after their last, as a span may start before a head's rows and a tile or span
// run past them (into another head's, for pairs that are masked).
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_control_flow_attributes : require
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_KHR_shader_subgroup_vote : require

layout(local_size_x = 128) in;

layout(std430, binding = 0) readonly buffer QC { vec4 qc[]; };
layout(std430, binding = 1) readonly buffer QP { vec4 qp[]; };
layout(std430, binding = 2) readonly buffer K { float16_t k[]; };
layout(std430, binding = 3) readonly buffer V { float16_t v[]; };
layout(std430, binding = 4) readonly buffer P { float16_t p[]; };
layout(std430, binding = 5) writeonly buffer O { float o[]; };

layout(push_constant) uniform PushConstants {
    uint positions;
    uint keys;
    uint heads;
    uint head4;
    // the table's rows a head, and the row (i, j) reads less j - i, from a head's first row
    uint p_rows;
    uint pos_base;
    // in vec4s
    uint qc_off;
    uint qp_off;
    // in floats
    uint o_off;
    // the first position of this piece of the call
    uint first;
} pc;

const uint THREADS = 128;
const uint SUBGROUPS = 4;
const uint M = 16;
const uint BR = SUBGROUPS * M;
const uint BC = 32;
const uint MAX_HEAD = 128;
const uint MAX_CHUNKS = MAX_HEAD / M;
// a subgroup's position span a tile, in whole 16-row matrices: M + BC - 1 rows
const uint SPAN = M + BC;
const uint SPAN_CHUNKS = SPAN / M;
// the tables' padding rows before their first head: a last workgroup's subgroups past the positions start up to BR
// rows early
const uint FRONT = BR;
const uint KV_STRIDE = MAX_HEAD + 8;
const uint S_STRIDE = BC + 4;
const uint P_STRIDE = BC + 8;
const uint POS_STRIDE = SPAN + 4;
const float MASKED = -1e30;
const float RESCALE = 8.0;

// the queries on their way to A matrices, half the workgroup's rows at a time
shared float16_t q_stage[BC * KV_STRIDE];
shared float scores[BR * S_STRIDE];
shared float pos_sh[BR * POS_STRIDE];
shared float16_t probs[BR * P_STRIDE];
shared float corr_sh[BR];

coopmat<float16_t, gl_ScopeSubgroup, M, M, gl_MatrixUseA> qa[MAX_CHUNKS];
coopmat<float16_t, gl_ScopeSubgroup, M, M, gl_MatrixUseA> qpa[MAX_CHUNKS];

// a query set's 64 rows into A matrices
void load_queries(bool position, uint head, uint pos0, uint batch) {
    uint t = gl_LocalInvocationID.x;
    uint sg = gl_SubgroupID;
    uint hs4 = pc.head4;
    uint chunks = hs4 * 4 / M;
    [[unroll]] for (uint half_ = 0; half_ < 2; half_++) {
        for (uint i = t; i < BC * hs4; i += THREADS) {
            uint r = half_ * BC + i / hs4;
            uint d = (i % hs4) * 4;
            uint pos = pos0 + r;
            vec4 x = vec4(0.0);
            if (pos < pc.positions) {
                uint at = ((batch * pc.heads + head) * pc.positions + pos) * hs4 + d / 4;
                x = position ? qp[pc.qp_off + at] : qc[pc.qc_off + at];
            }
            uint at = (i / hs4) * KV_STRIDE + d;
            q_stage[at] = float16_t(x.x);
            q_stage[at + 1] = float16_t(x.y);
            q_stage[at + 2] = float16_t(x.z);
            q_stage[at + 3] = float16_t(x.w);
        }
        barrier();
        if (sg / 2 == half_) {
            [[unroll]] for (uint c = 0; c < MAX_CHUNKS; c++) {
                if (c < chunks) {
                    uint off = ((sg % 2) * M) * KV_STRIDE + c * M;
                    if (position) {
                        coopMatLoad(qpa[c], q_stage, off, KV_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
                    } else {
                        coopMatLoad(qa[c], q_stage, off, KV_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
                    }
                }
            }
        }
        barrier();
    }
}

void main() {
    uint head = gl_WorkGroupID.y;
    uint batch = gl_WorkGroupID.z;
    uint t = gl_LocalInvocationID.x;
    uint sg = gl_SubgroupID;
    uint lane = gl_SubgroupInvocationID;
    uint pos0 = pc.first + gl_WorkGroupID.x * BR;
    uint hs4 = pc.head4;
    uint hs = hs4 * 4;
    uint chunks = hs / M;

    // this thread's row of the softmax (a pair of lanes a row, half the tile each)
    uint r = lane / 2;
    uint srow = sg * M + r;
    uint side = lane % 2;
    uint spos = pos0 + srow;
    bool live = spos < pc.positions;
    uint row_end = live ? pc.keys : 0;
    // the head's first key and position rows in their tables
    uint kv_head = FRONT + (batch * pc.heads + head) * pc.keys;
    uint p_head = FRONT + (batch * pc.heads + head) * pc.p_rows;
    uint sg_last = pos0 + sg * M + M - 1;

    load_queries(false, head, pos0, batch);
    load_queries(true, head, pos0, batch);

    coopmat<float, gl_ScopeSubgroup, M, M, gl_MatrixUseAccumulator> acc[MAX_CHUNKS];
    [[unroll]] for (uint c = 0; c < MAX_CHUNKS; c++) {
        acc[c] = coopmat<float, gl_ScopeSubgroup, M, M, gl_MatrixUseAccumulator>(0.0);
    }
    float m = MASKED;
    float l = 0.0;

    for (uint p0 = 0; p0 < pc.keys; p0 += BC) {
        [[unroll]] for (uint c = 0; c < BC / M; c++) {
            coopmat<float, gl_ScopeSubgroup, M, M, gl_MatrixUseAccumulator> s =
                coopmat<float, gl_ScopeSubgroup, M, M, gl_MatrixUseAccumulator>(0.0);
            [[unroll]] for (uint j = 0; j < MAX_CHUNKS; j++) {
                if (j < chunks) {
                    coopmat<float16_t, gl_ScopeSubgroup, M, M, gl_MatrixUseB> kb;
                    coopMatLoad(kb, k, (kv_head + p0 + c * M) * hs + j * M, hs, gl_CooperativeMatrixLayoutColumnMajor);
                    s = coopMatMulAdd(qa[j], kb, s);
                }
            }
            coopMatStore(s, scores, (sg * M) * S_STRIDE + c * M, S_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
        }
        // the span's rows: the subgroup's last row against this tile's first key, on
        int span0 = int(p_head) + int(pc.pos_base) - int(sg_last) + int(p0);
        [[unroll]] for (uint c = 0; c < SPAN_CHUNKS; c++) {
            coopmat<float, gl_ScopeSubgroup, M, M, gl_MatrixUseAccumulator> s =
                coopmat<float, gl_ScopeSubgroup, M, M, gl_MatrixUseAccumulator>(0.0);
            uint row0 = uint(span0 + int(c * M));
            [[unroll]] for (uint j = 0; j < MAX_CHUNKS; j++) {
                if (j < chunks) {
                    coopmat<float16_t, gl_ScopeSubgroup, M, M, gl_MatrixUseB> pb;
                    coopMatLoad(pb, p, row0 * hs + j * M, hs, gl_CooperativeMatrixLayoutColumnMajor);
                    s = coopMatMulAdd(qpa[j], pb, s);
                }
            }
            coopMatStore(s, pos_sh, (sg * M) * POS_STRIDE + c * M, POS_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
        }
        subgroupMemoryBarrierShared();
        subgroupBarrier();

        float sv[BC / 2];
        float tile_max = MASKED;
        [[unroll]] for (uint j = 0; j < BC / 2; j++) {
            uint jj = side * (BC / 2) + j;
            bool valid = p0 + jj < row_end;
            float score = scores[srow * S_STRIDE + jj] + pos_sh[srow * POS_STRIDE + (M - 1 - r) + jj];
            sv[j] = valid ? max(score, MASKED) : MASKED;
            tile_max = max(tile_max, sv[j]);
        }
        tile_max = max(tile_max, subgroupShuffleXor(tile_max, 1));
        float corr = 1.0;
        bool moved = tile_max > m + RESCALE || (m == MASKED && tile_max > MASKED);
        if (moved) {
            corr = m == MASKED ? 0.0 : exp(m - tile_max);
            m = tile_max;
            l *= corr;
        }
        [[unroll]] for (uint j = 0; j < BC / 2; j++) {
            float e = sv[j] > MASKED ? exp(sv[j] - m) : 0.0;
            l += e;
            probs[srow * P_STRIDE + side * (BC / 2) + j] = float16_t(e);
        }
        if (side == 0) {
            corr_sh[srow] = corr;
        }
        if (subgroupAny(moved && corr != 0.0)) {
            subgroupMemoryBarrierShared();
            subgroupBarrier();
            [[unroll]] for (uint c = 0; c < MAX_CHUNKS; c++) {
                if (c < chunks) {
                    coopMatStore(acc[c], scores, (sg * M) * S_STRIDE, S_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
                    subgroupMemoryBarrierShared();
                    subgroupBarrier();
                    [[unroll]] for (uint e = lane; e < M * M; e += 32) {
                        uint rr = e / M;
                        scores[(sg * M + rr) * S_STRIDE + e % M] *= corr_sh[sg * M + rr];
                    }
                    subgroupMemoryBarrierShared();
                    subgroupBarrier();
                    coopMatLoad(acc[c], scores, (sg * M) * S_STRIDE, S_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
                    subgroupBarrier();
                }
            }
        }
        subgroupMemoryBarrierShared();
        subgroupBarrier();

        [[unroll]] for (uint c = 0; c < BC / M; c++) {
            coopmat<float16_t, gl_ScopeSubgroup, M, M, gl_MatrixUseA> pa;
            coopMatLoad(pa, probs, (sg * M) * P_STRIDE + c * M, P_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
            [[unroll]] for (uint j = 0; j < MAX_CHUNKS; j++) {
                if (j < chunks) {
                    coopmat<float16_t, gl_ScopeSubgroup, M, M, gl_MatrixUseB> vb;
                    coopMatLoad(vb, v, (kv_head + p0 + c * M) * hs + j * M, hs, gl_CooperativeMatrixLayoutRowMajor);
                    acc[j] = coopMatMulAdd(pa, vb, acc[j]);
                }
            }
        }
        // the next tile's scores and probabilities overwrite this one's
        subgroupMemoryBarrierShared();
        subgroupBarrier();
    }

    l += subgroupShuffleXor(l, 1);
    float inv = l > 0.0 ? 1.0 / l : 0.0;
    uint at = pc.o_off + ((batch * pc.heads + head) * pc.positions + spos) * hs;
    [[unroll]] for (uint c = 0; c < MAX_CHUNKS; c++) {
        if (c < chunks) {
            coopMatStore(acc[c], scores, (sg * M) * S_STRIDE, S_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
            subgroupMemoryBarrierShared();
            subgroupBarrier();
            if (live) {
                [[unroll]] for (uint j = 0; j < M / 2; j++) {
                    uint col = side * (M / 2) + j;
                    o[at + c * M + col] = scores[srow * S_STRIDE + col] * inv;
                }
            }
            subgroupBarrier();
        }
    }
}
